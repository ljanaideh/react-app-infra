# Copy to scripts/.env.atlantis.local and fill in (that file is gitignored).
# Atlantis server: https://www.runatlantis.io/docs/server-configuration.html

# --- GitHub (PAT: classic "repo" scope, or fine-grained with repo Contents + webhooks if using --update-github-webhook) ---
ATLANTIS_GH_USER=your-github-username
ATLANTIS_GH_TOKEN=ghp_replace_me

# Optional; must match GitHub webhook "Secret" if you set one there
ATLANTIS_GH_WEBHOOK_SECRET=

# Comma-separated; must match Atlantis allowlist
ATLANTIS_REPO_ALLOWLIST=github.com/your-org/your-repo

# After ngrok: set for correct PR links, then restart Atlantis
# ATLANTIS_ATLANTIS_URL=https://xxxx.ngrok-free.app

# For ./scripts/run-atlantis-local.sh --with-ngrok --update-github-webhook
# ID from: https://github.com/org/repo/settings/hooks/<id>
GITHUB_WEBHOOK_ID=

# Optional; defaults to ATLANTIS_GH_TOKEN for the webhook PATCH
# GITHUB_WEBHOOK_TOKEN=

# Terraform version Atlantis installs for plans (see atlantis.yaml TERRAGRUNT_TFPATH)
ATLANTIS_DEFAULT_TF_VERSION=1.9.8

# --- AWS (Terragrunt remote state + applies); script mounts ~/.aws read-only ---
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default
TF_STATE_BUCKET=react-app-tfstate-laith
