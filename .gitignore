*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

.env
.env.*
!.env.example

node_modules/
app/build/
app/coverage/

*.log
npm-debug.log*
yarn-debug.log*

.DS_Store
.idea/
.vscode/
*.swp
*~

*.pem
